PORT=3000
HOST=0.0.0.0
# Required for an internet-facing deployment. Use the exact HTTPS origin.
# PUBLIC_ORIGIN=https://captcha.example.com
# Comma-separated origins allowed to embed the widget. Defaults to PUBLIC_ORIGIN.
# ALLOWED_ORIGINS=https://app.example.com
# Generate a random server secret, at least 32 characters. Never put it in client code.
# CAPTCHA_SECRET=
# An omitted development secret is generated once in .data/development-secret.
DATABASE_PATH=.data/captcha.sqlite
SITE_KEY=zetther_local_demo
# Local single-process limits. Put a trusted rate-limiting proxy in front of a public deployment.
